{
  "name": "@accountability/evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./objects": {
      "types": "./dist/objects.d.ts",
      "default": "./dist/objects.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./serve": {
      "types": "./dist/engine/serve.d.ts",
      "default": "./dist/engine/serve.js"
    },
    "./service-kit": {
      "types": "./dist/service-kit.d.ts",
      "default": "./dist/service-kit.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs && npm run check:installed",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check:installed": "node scripts/check-installed-service.mjs",
    "serve": "node src/engine/serve.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "migrations"
  ],
  "dependencies": {
    "pg": "8.23.1"
  }
}
